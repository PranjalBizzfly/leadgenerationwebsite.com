# Copy to .env.local for local development; set the same names in Vercel → Project → Settings → Environment Variables.

# --- Salesforge inbound webhook: default listener (used by the Contact and Request Access forms) ---
# URL from Salesforge → Settings → Integrations → Inbound webhooks → (listener) → Connection.
SALESFORGE_INBOUND_URL=
# Signing secret (whsec_…) for the Signature method. Wins over the token when both are set.
SALESFORGE_INBOUND_SECRET=
# Bearer token, only if the listener uses the Bearer method instead.
SALESFORGE_INBOUND_TOKEN=

# Optional: completes local phone numbers (e.g. 098765 43210 → +919876543210). The forms already send
# international numbers, so this only matters for other sources.
# Example value: +91
SALESFORGE_DEFAULT_COUNTRY_CODE=

# --- Optional: forward every submission as raw JSON to another webhook as well ---
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TIMEOUT_MS=
